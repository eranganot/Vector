# Copy to .env for local development. Never commit .env.
# Postgres connection (local: docker compose; Railway: injected from the Postgres service)
DATABASE_URL=postgres://vector:vector@localhost:5432/vector
# Environment name shown in /api/health: local | dev | demo
VECTOR_ENV=local
# Log level for pino: debug | info | warn | error
LOG_LEVEL=info
# Password for seeded demo users (required outside local/test). Never commit a real value.
SEED_USER_PASSWORD=
# Demo-only features: persona switcher (on/off) and demo controls (anything but "off" enables them for Admin)
DEMO_PERSONAS=on
DEMO_CONTROLS=on
# Restricted app role connection (see scripts/db-roles.ts). Optional locally.
APP_DATABASE_URL=
# Better Auth: secret (>= 32 chars) and the public base URL
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Integration tests only: a separate *_test database (they forge audit rows on purpose)
TEST_DATABASE_URL=postgres://vector:vector@localhost:5432/vector_test
